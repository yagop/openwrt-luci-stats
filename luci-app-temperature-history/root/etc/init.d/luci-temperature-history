#!/bin/sh /etc/rc.common
# Long-lived collector that samples hwmon temperatures into RRD files on
# tmpfs. procd restarts it if it dies; history is kept only in RAM.

USE_PROCD=1
START=95
STOP=10

PROG=/usr/libexec/luci-temperature-history/collect

start_service() {
	procd_open_instance
	procd_set_param command "$PROG"
	procd_set_param respawn 3600 5 0
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}
