// rpcd ucode plugin: serves persisted temperature history from the RRD
// files written by the collector, as ubus object "luci.temperature.history".
//
//   ubus call luci.temperature.history getHistory '{ "range": 3600 }'
//
// Returns { step, series: { <sensor id>: [[ts, temp], ...] } }. Sensor
// labels, limits and the current value come from luci.temperature; this
// object only supplies the past curve.

'use strict';

import { popen, lsdir } from 'fs';

const RRD_DIR = '/tmp/luci-temperature-rrd';
const RRD = '/usr/bin/rrdtool';
const MAX_POINTS = 320;   // cap rows returned per sensor; sets fetch resolution

function clamp(n, lo, hi) {
	n = int(n);
	if (n != n || n < lo) return lo;
	if (n > hi) return hi;
	return n;
}

// Parse `rrdtool fetch` output: a header line, a blank line, then rows of
// "<timestamp>: <value>". Non-finite samples (UNKNOWN) are dropped.
// -r is only a hint: rrdtool picks the RRA itself (a 6 h fetch is served
// from the 5 min RRA), so the real step is taken from consecutive rows.
function fetchSeries(file, range, res) {
	const p = popen(sprintf('%s fetch %s AVERAGE -s -%d -r %d 2>/dev/null',
		RRD, file, range, res));
	if (!p)
		return { step: 0, rows: [] };

	const out = p.read('all') ?? '';
	p.close();

	const series = [];
	let step = 0, prev = null;
	for (let line in split(out, '\n')) {
		const m = match(line, /^[ \t]*([0-9]+):[ \t]+(.+)$/);
		if (!m)
			continue;
		const ts = +m[1];
		const v = +m[2];
		if (prev != null && !step)
			step = ts - prev;
		prev = ts;
		if (v == v && ts == ts)      // drop nan / -nan
			push(series, [ ts, v ]);
	}
	return { step: step, rows: series };
}

const methods = {
	getHistory: {
		args: { range: 0 },
		call: function(req) {
			const range = clamp(req.args?.range ?? 3600, 60, 86400);
			const res = max(30, int(range / MAX_POINTS));
			const series = {};
			let step = 0;

			for (let f in (lsdir(RRD_DIR) || [])) {
				if (!match(f, /^[A-Za-z0-9_]+\.rrd$/))
					continue;
				const id = substr(f, 0, length(f) - 4);
				const r = fetchSeries(RRD_DIR + '/' + f, range, res);
				series[id] = r.rows;
				step = max(step, r.step);
			}

			return { step: step || res, series: series };
		}
	}
};

return { 'luci.temperature.history': methods };
