// rpcd ucode plugin: exposes all hwmon temperature sensors (and PWM fans)
// as ubus object "luci.temperature".
//
//   ubus call luci.temperature getSensors
//
// All discovery lives in the shared module so the history collector
// (luci-app-temperature-history) samples the exact same sensor set.

'use strict';

import { collect } from 'luci.temperature.sensors';

const methods = {
	getSensors: {
		call: function() {
			return collect();
		}
	}
};

return { 'luci.temperature': methods };
